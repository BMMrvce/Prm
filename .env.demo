# Copy this file to .env.local or configure the same names in your deployment.
# DEMO PLACEHOLDERS ONLY — never commit real credentials.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-in-deployment-secrets

# Office — Hostinger Mail (server-only)
HOSTINGER_IMAP_HOST=imap.hostinger.com
HOSTINGER_IMAP_PORT=993
HOSTINGER_SMTP_HOST=smtp.hostinger.com
HOSTINGER_SMTP_PORT=465
HOSTINGER_MAIL_USER=office@example.com
HOSTINGER_MAIL_PASSWORD=replace-in-deployment-secrets

# Studio — Microsoft Outlook OAuth (server-only)
OUTLOOK_CLIENT_ID=your-microsoft-entra-client-id
OUTLOOK_CLIENT_SECRET=replace-in-deployment-secrets

# Personal — Gmail OAuth (server-only)
GMAIL_CLIENT_ID=your-google-client-id
GMAIL_CLIENT_SECRET=replace-in-deployment-secrets

# Generate a 32-byte key for AES-256-GCM token encryption.
OAUTH_TOKEN_ENCRYPTION_KEY=replace-with-a-random-32-byte-key
