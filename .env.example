# Supabase browser-safe project settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
OAUTH_TOKEN_ENCRYPTION_KEY=
# Public URL once deployed; OAuth redirect URIs are built from it (defaults to the request origin).
SITE_URL=
# Google OAuth web client for Gmail and YouTube. Enable the Gmail API and YouTube Data API v3
# and add <site>/api/oauth/google/callback as a redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
# "common" for work/school + personal accounts, or your Entra tenant ID for a single-tenant app.
OUTLOOK_TENANT_ID=common
# Hostinger servers. Users enter their own mailbox address and password in Integrations.
HOSTINGER_IMAP_HOST=imap.hostinger.com
HOSTINGER_IMAP_PORT=993
HOSTINGER_SMTP_HOST=smtp.hostinger.com
HOSTINGER_SMTP_PORT=465
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
CRON_SECRET=
